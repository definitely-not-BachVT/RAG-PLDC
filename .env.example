# Copy to .env and fill in. Never commit .env.

# DeepSeek is tried first for chat/explanations.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini: fallback for chat, and always used for embeddings (DeepSeek has no embedding API).
GOOGLE_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-flash-lite-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Seconds before giving up on a provider and falling back.
# LLM_TIMEOUT=30
