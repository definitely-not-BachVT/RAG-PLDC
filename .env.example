# Copy to .env and fill in. Never commit .env.

# Gemini: chat/explanations (models tried in order) and embeddings.
GOOGLE_API_KEY=
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.8-flash,gemini-flash-latest   # fastest first
# GEMINI_THINKING_BUDGET=0   # 0 = no thinking (much faster first token); empty = model default
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Seconds before giving up on a model and falling back to the next.
# LLM_TIMEOUT=30

# Search: EMBEDDER=gemini (API) or local (bge-m3, models/bge-m3). Each has its own index.
# EMBEDDER=gemini
# Reranker (bge-reranker-v2-m3, models/bge-reranker-v2-m3): auto = only when a GPU is available
# (~1 s per question; ~25 s on the CPU), on = always, off = never.
# RERANKER=auto
# RERANK_CANDIDATES=20   # first-stage hits the reranker re-scores
